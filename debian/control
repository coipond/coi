# The code-on-incus team has no Launchpad mailing list, so an address there
# would bounce silently. Bug reports are routed to GitHub via XB-Bugs below
# rather than to this inbox.
Maintainer: Maciej Mensfeld <maciej@mensfeld.pl>
Build-Depends: debhelper-compat (= 13),
               golang-1.25-go,
               pkg-config,
               libsystemd-dev
Standards-Version: 4.7.0
Homepage: https://github.com/mensfeld/code-on-incus
