#!/usr/bin/make -f
# Packaging for code-on-incus (coi).
#
# The offline Launchpad builders have no network, so Go modules are vendored
# (vendor/, generated by `go mod vendor` before building) and GOPROXY is off.
# Go 1.25 is not in the LTS archives; it comes from ppa:longsleep/golang-backports,
# which must be added as an "archive dependency" of your PPA (see debian/README.source).

export DH_VERBOSE = 1

# Use the versioned Go 1.25 toolchain from golang-1.25-go, not the distro default.
export PATH := /usr/lib/go-1.25/bin:$(PATH)
export GOTOOLCHAIN := local
export GOFLAGS := -mod=vendor
export GOPROXY := off
export GOCACHE := $(CURDIR)/_build/go-cache
export GOPATH := $(CURDIR)/_build/gopath
# coi uses cgo to read the systemd journal (needs libsystemd-dev + pkg-config).
export CGO_ENABLED := 1

IMPORT := github.com/mensfeld/code-on-incus
VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/[~-].*//')

# -s -w: strip here rather than leaving it to dh_strip (see override_dh_dwz).
# InstallSource=deb makes `coi update core` refuse to overwrite the dpkg-owned
# /usr/bin/coi behind the package manager's back; source builds default to
# "source" and keep the self-updater.
# -extldflags -Wl,-z,now: full RELRO. Go emits -z relro but not -z now, which
# lintian reports as hardening-no-bindnow. Paired with -buildmode=pie in
# override_dh_auto_build, this clears both hardening tags; coi is a security
# tool, so shipping it without ASLR would be off-message.
GO_LDFLAGS := -s -w \
	-X $(IMPORT)/internal/cli.Version=$(VERSION) \
	-X $(IMPORT)/internal/cli.InstallSource=deb \
	-extldflags=-Wl,-z,now

%:
	dh $@

# Mirrors the upstream Makefile `build` target: stage the go:embed assets, then
# build the single cmd/coi binary. Deliberately NOT identical to it — this adds
# -trimpath (reproducible builds), -s -w (see override_dh_dwz), and the
# InstallSource stamp, none of which apply to a developer's local build.
override_dh_auto_build:
	mkdir -p internal/image/embedded internal/config/embedded
	cp profiles/default/config.toml internal/config/embedded/default_config.toml
	cp testdata/dummy/dummy internal/image/embedded/dummy
	go build -trimpath -buildmode=pie -mod=vendor -ldflags "$(GO_LDFLAGS)" -o coi ./cmd/coi

# Integration tests need a live Incus daemon; not runnable on a builder.
override_dh_auto_test:

# Go binaries strip clean with -s -w above; dwz cannot compress Go DWARF and errors.
override_dh_dwz:

# -s -w already discarded the symbol and DWARF tables, so the automatic -dbgsym
# package would be an empty shell that is pointless to build and ship.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_install:
	install -D -m0755 coi debian/code-on-incus/usr/bin/coi

override_dh_auto_clean:
	# Only remove generated/untracked artifacts. internal/config/embedded/
	# default_config.toml is tracked upstream, so it is left in place.
	rm -rf _build coi internal/image/embedded
