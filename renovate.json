{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "includePaths": [
    "go.mod",
    "go.sum",
    "tests/support/requirements.txt",
    ".github/workflows/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchFileNames": [
        "tests/support/requirements.txt"
      ],
      "groupName": "test dependencies",
      "commitMessageTopic": "test dependencies"
    },
    {
      "description": "Major updates stay manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "minimumReleaseAge": "7 days",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on the first day of the month"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "automerge": true,
  "platformAutomerge": true
}
